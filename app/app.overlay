/ {
	aliases {
		app-led = &green_led;
	};

	led_sensor: led_sensor {
		compatible = "custom,led-sensor";
		led-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&clk_hse {
	status = "disabled";
};

&pll {
	status = "disabled";
};

&pll2 {
	status = "disabled";
};

&rcc {
	clocks = <&clk_hsi>;
	clock-frequency = <DT_FREQ_M(64)>;
	hpre = <1>;
	d1ppre = <1>;
	d2ppre1 = <1>;
	d2ppre2 = <1>;
	d3ppre = <1>;
};
